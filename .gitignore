# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# typescript incremental build info (tsconfig sets "incremental": true)
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# generated files
/public/rss/

# python bytecode from the bundled skill scripts under .claude/skills
__pycache__/
*.py[cod]

# source masters for generated assets — kept locally, never shipped. Regenerate with
# `node scripts/optimize-hero-images.mjs` (see public/images/hero).
/.assets/